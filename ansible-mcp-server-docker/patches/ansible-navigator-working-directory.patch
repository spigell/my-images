+/**
+ * Resolve the Ansible project directory used for a single invocation.
+ * A caller-selected directory is always constrained to WORKSPACE_ROOT.
+ */
+async function resolveAndValidateExecutionDirectory(
+  workingDirectory?: string,
+  workspaceRoot?: string,
+): Promise<string> {
+  const executionDirectory = workingDirectory
+    ? workspaceRoot
+      ? validatePathWithinWorkspace(workingDirectory, workspaceRoot)
+      : resolve(workingDirectory)
+    : workspaceRoot
+      ? resolve(workspaceRoot)
+      : process.cwd();
+
+  const directoryStats = await stat(executionDirectory);
+  if (!directoryStats.isDirectory()) {
+    throw new Error(
+      `Working directory is not a directory: ${executionDirectory}`,
+    );
+  }
+
+  return executionDirectory;
+}
