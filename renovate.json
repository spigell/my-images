{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>spigell/my-renovate",
    "github>spigell/my-renovate//presets/dockerfile-managers",
    "github>spigell/my-renovate//presets/workflow-managers"
  ],
  "commitMessageExtra": "",

  "packageRules": [
    {
      "enabled": false,
      "matchPackageNames": ["/ghcr.io/spigell/*/"]
    },
    {
      "enabled": true,
      "matchDepNames": ["werf/werf"],
      "allowedVersions": "/^2\\.31\\.1$/"
    },
    {
      "enabled": false,
      "matchDepNames": ["@commitlint/cli"],
      "allowedVersions": "/^19\\.5\\.0$/"
    },
    {
      "enabled": false,
      "matchDepNames": ["yamllint"],
      "allowedVersions": "/^1\\.35\\.1$/"
    },
    {
      "matchDepNames": [
        "/^antigravity-cli-/"
      ],
      "groupName": "antigravity-cli"
    },
    {
      "matchDepNames": ["spigell-codex-binary"],
      "extractVersion": "^rust-(?<version>v\\d+\\.\\d+\\.\\d+)$",
      "versioning": "semver-coerced",
      "schedule": ["before 8am on Saturday"]
    },
    {
      "matchPackageNames": ["linuxserver/openssh-server"],
      "versioning": "regex:^version-(?<major>\\d+)\\.(?<minor>\\d+)_p(?<patch>\\d+)-r(?<build>\\d+)$"
    },
    {
      "matchDepNames": ["neurosnap/zmx"],
      "automerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchDepNames": ["sonirico/mcp-shell"],
      "allowedVersions": "/^v0\\.7\\.0$/"
    },
    {
      "matchDepNames": [
        "debian",
        "ubuntu",
        "golang",
        "alpine",
        "lsiobase/kasmvnc",
        "python",
        "node",
        "go",
        "golangci/golangci-lint",
        "go-delve/delve",
        "yarnpkg/yarn",
        "mikefarah/yq",
        "sparfenyuk/mcp-proxy",
        "sonirico/mcp-shell"
      ],
      "groupName": "platform foundation",
      "automerge": false,
      "branchPrefix": "renovate/",
      "branchTopic": "platform-foundation",
      "minimumReleaseAge": "7 days",
      "schedule": ["before 8am on Saturday"]
    },
    {
      "matchDepNames": [
        "kubernetes/kubernetes",
        "helm/helm",
        "helm-unittest/helm-unittest",
        "derailed/k9s",
        "siderolabs/talos",
        "etcd-io/etcd",
        "kubernetes-sigs/krew",
        "tohjustin/kube-lineage",
        "hetznercloud/cli",
        "HolmesGPT/holmesgpt",
        "argoproj/argo-cd",
        "google-cloud-sdk"
      ],
      "groupName": "debug-sre-workbench",
      "automerge": false,
      "branchPrefix": "renovate/",
      "branchTopic": "debug-sre-workbench-deps",
      "schedule": ["before 8am on Saturday"]
    },
    {
      "matchDepNames": [
        "awslabs.eks-mcp-server",
        "awslabs.aws-pricing-mcp-server"
      ],
      "groupName": "aws-mcp-server",
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "branchPrefix": "renovate/",
      "branchTopic": "aws-mcp-server-deps",
      "schedule": ["before 8am on Saturday"]
    },
    {
      "matchDepNames": [
        "pulumi/pulumi",
        "pulumi/pulumictl",
        "@pulumi/mcp-server",
        "hashicorp/packer",
        "hashicorp/terraform",
        "hashicorp/terraform-provider-aws",
        "hashicorp/terraform-provider-vault",
        "gruntwork-io/terragrunt",
        "tofuutils/tenv"
      ],
      "groupName": "infra-workbenches",
      "branchPrefix": "renovate/",
      "branchTopic": "infra-workbenches-deps",
      "schedule": ["before 8am on Saturday"]
    },
    {
      "matchDepNames": [
        "github/github-mcp-server",
        "ansible/vscode-ansible",
        "tavily-mcp",
        "notebooklm-mcp-cli"
      ],
      "automerge": false,
      "branchPrefix": "renovate/",
      "schedule": ["before 8am on Saturday"]
    },
    {
      "matchDepNames": [
        "spigell-codex-binary",
        "@anthropic-ai/claude-code",
        "@anthropic-ai/sandbox-runtime",
        "google-antigravity/antigravity-cli"
      ],
      "automerge": false,
      "groupName": "hot-agent-workbenches",
      "branchPrefix": "renovate/",
      "branchTopic": "hot-agent-workbenches-deps",
      "schedule": ["before 8am on Saturday"]
    },
    {
      "matchDepNames": [
        "github/spec-kit",
        "@qwen-code/qwen-code",
        "@google/gemini-cli",
        "@google/jules"
      ],
      "automerge": false,
      "groupName": "abandoned-agent-workbenches",
      "branchPrefix": "renovate/",
      "branchTopic": "abandoned-agent-workbenches-deps",
      "schedule": ["before 8am on the first day of the month"]
    },
    {
      "matchDepNames": ["actions/runner"],
      "groupName": "github-runners",
      "branchTopic": "github-runners-deps"
    },
    {
      "matchDepNames": ["google-cloud-sdk"],
      "allowedVersions": "/^581\\.0\\.0$/"
    },
    {
      "matchDepNames": ["helm/helm"],
      "allowedVersions": "/^3\\.19\\.5$/"
    },
    {
      "matchDepNames": ["kubernetes/kubernetes"],
      "allowedVersions": "/^1\\.37\\.0$/"
    },
    {
      "matchDepNames": ["helm-unittest/helm-unittest"],
      "allowedVersions": "/^1\\.1\\.2$/"
    },
    {
      "matchDepNames": ["derailed/k9s"],
      "allowedVersions": "/^0\\.51\\.0$/"
    },
    {
      "matchDepNames": ["etcd-io/etcd"],
      "allowedVersions": "/^3\\.7\\.1$/"
    },
    {
      "matchDepNames": ["kubernetes-sigs/krew"],
      "allowedVersions": "/^v?0\\.5\\.0$/"
    },
    {
      "matchDepNames": ["tohjustin/kube-lineage"],
      "allowedVersions": "/^0\\.5\\.0$/"
    },
    {
      "matchDepNames": ["hetznercloud/cli"],
      "allowedVersions": "/^1\\.67\\.0$/"
    },
    {
      "matchDepNames": ["HolmesGPT/holmesgpt"],
      "allowedVersions": "/^0\\.40\\.0$/"
    },
    {
      "matchDepNames": ["argoproj/argo-cd"],
      "allowedVersions": "/^3\\.5\\.2$/"
    },
    {
      "matchDepNames": ["pulumi/pulumi"],
      "allowedVersions": "/^3\\.252\\.0$/"
    },
    {
      "matchDepNames": ["pulumi/pulumictl"],
      "allowedVersions": "/^0\\.0\\.50$/"
    },
    {
      "matchDepNames": ["@pulumi/mcp-server"],
      "allowedVersions": "/^0\\.2\\.0$/"
    },
    {
      "matchDepNames": ["hashicorp/packer"],
      "allowedVersions": "/^1\\.16\\.0$/"
    },
    {
      "matchDepNames": ["hashicorp/terraform"],
      "allowedVersions": "/^1\\.15\\.1$/"
    },
    {
      "matchDepNames": ["hashicorp/terraform-provider-aws"],
      "allowedVersions": "/^6\\.45\\.0$/"
    },
    {
      "matchDepNames": ["hashicorp/terraform-provider-vault"],
      "allowedVersions": "/^4\\.6\\.0$/"
    },
    {
      "matchDepNames": ["gruntwork-io/terragrunt"],
      "allowedVersions": "/^1\\.0\\.2$/"
    },
    {
      "matchDepNames": ["tofuutils/tenv"],
      "allowedVersions": "/^v?4\\.15\\.1$/"
    }
  ]
}
